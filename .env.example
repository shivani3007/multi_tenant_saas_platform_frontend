# Copy to `.env` and point at your API.
# Everything below is read in src/config/env.ts — no other file reads import.meta.env.


# Authentication source: `mock` | `api`
#
#   mock — built-in stand-in login (admin@test.com / admin123). No backend needed.
#   api  — the real POST /auth/login, /auth/refresh, /auth/me endpoints.
#
# Unset defaults to `mock` in dev and `api` in production builds, so a real
# deployment can't accidentally ship the fake login. Flip this to `api` (and
# delete src/api/services/auth.mock.ts) once the backend is live.
VITE_AUTH_MODE=mock

# Refresh the access token this many ms before it actually expires, so an
# in-flight request never races the expiry. 45s is a safe default.
VITE_TOKEN_REFRESH_SKEW_MS=45000

# Server-side page size requested from GET /files.
VITE_FILES_PAGE_SIZE=50

# How often the File Manager re-polls non-terminal (pending/processing) files.
VITE_FILE_POLL_INTERVAL_MS=3000

# Row count above which the file list switches to a virtualised renderer.
VITE_VIRTUALIZE_THRESHOLD=100

# User `true` for localhost testing and `false` for production.
VITE_TEST_MODE=true

# Only used when `VITE_TEST_MODE=true` 
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Only used when `VITE_TEST_MODE=true`, this will pass in `X-Subdomain` header
VITE_TENANT_SLUG='germany'